#!/usr/bin/env bash
# Repo público: bloquea documentos y datos personales aunque se fuercen con `git add -f`.
set -euo pipefail
fallo=0
while IFS= read -r -d '' f; do
  case "$f" in
    privado/*|Carrera/*) echo "✗ $f: carpeta privada, no se sube"; fallo=1 ;;
    *.pdf|*.PDF|*.doc|*.docx|*.xls|*.xlsx|*.ppt|*.pptx|*.odt|*.ods|*.odp|*.zip|*.rar)
      echo "✗ $f: documento (PDF/Office/zip), no se sube"; fallo=1 ;;
  esac
done < <(git diff --cached --name-only -z --diff-filter=ACMR)
# Cédula y teléfonos venezolanos en lo que se agrega.
if git diff --cached -U0 --diff-filter=ACMR | grep -E '^\+' | grep -v '^+++' \
   | grep -q -E '25\.?215\.?355|\b0?4(12|14|16|24|26)[- ]?[0-9]{3}[- ]?[0-9]{4}\b'; then
  echo "✗ El cambio contiene una cédula o un teléfono: eso va en privado/ o en Firestore"; fallo=1
fi
[ "$fallo" = 0 ] || { echo "Commit bloqueado por .githooks/pre-commit"; exit 1; }
